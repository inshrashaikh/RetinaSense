# RetinaSense frontend environment.
# Copy to `.env` and adjust if needed. Defaults match the local dev setup below.

# Backend REST API root (the backend must be running on this URL).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set VITE_DEMO_MODE=true ONLY to run the clearly-labelled DEMO client, which
# returns SIMULATED data behind a persistent "DEMO MODE — SIMULATED DATA" banner.
# Never enable demo mode for a real screening workflow.
# VITE_DEMO_MODE=false