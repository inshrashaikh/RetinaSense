# RetinaSense frontend environment.
# Copy to `.env` and adjust if needed. Defaults match the local dev setup below.

# The Vite dev server proxies /api -> the backend target in vite.config.ts
# (VITE_PROXY_TARGET, default http://127.0.0.1:8000). In dev, leave this EMPTY
# so the browser talks to localhost:5173 same-origin — no CORS/host issues.
# For a build served against an explicit backend instead, set it to the API
# root, e.g. VITE_API_BASE_URL=http://127.0.0.1:8000

VITE_API_BASE_URL=

# Target the dev proxy uses to reach the RetinaSense backend.
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Set VITE_DEMO_MODE=true ONLY to run the clearly-labelled DEMO client, which
# returns SIMULATED data behind a persistent "DEMO MODE | SIMULATED DATA" banner.
# Never enable demo mode for a real screening workflow.
# VITE_DEMO_MODE=false