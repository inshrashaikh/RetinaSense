# IDRiD raw dataset (official IEEE DataPort distribution): fundus images,
# segmentation masks, grading/location markups, license PDFs. Tracked
# manifests live under data/manifests/ (committed); bound image/annotation
# data must never be committed.
data/raw/IDRiD/

# Biomedical datasets and derived tensors (licensing: APTOS, IDRiD, DRIVE,
# Messidor-2 require access agreements) - never commit.
data/raw/
data/processed/

# Trained model weights and fitted calibration artifacts.
data/models/

# Generated outputs (reports, logs, plots, metrics).
output/

# Python verifier cruft.
__pycache__/
*.pyc
tools/python_verifier/output/

# Demo image assets may be large (keep the small committed synthetic demo).
assets/*.jpg
assets/*.png
!assets/synthetic_fundus_demo.png

# Backend local storage — case data, uploaded images, test artifacts.
backend/data/cases/
backend/data/images/
backend/data/retinasense.db
backend/data/*.db
backend/data/*.db-journal
backend/data/*.sqlite3
backend/data/
backend/.pytest_cache/
backend/__pycache__/
backend/app/__pycache__/
backend/app/**/__pycache__/
backend/tests/__pycache__/
*.egg-info/

# MATLAB/OS cruft.
*.asv
*.mlappinstall
Thumbs.db
.DS_Store

# Frontend (React/Vite) — node_modules and build output.
frontend/node_modules/
frontend/dist/
frontend/.vite/
slprj/
tests/_last_run.csv
